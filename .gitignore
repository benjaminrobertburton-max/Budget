# Generated previews and inspection artifacts can be recreated from the builder.
outputs/**/*.png
outputs/**/*.ndjson

# Do not publish raw screenshots or local attachments.
sources/
work/node_modules/
*.tmp

# Private local direct-browser collector state. Keep real banking data and
# authenticated browser/session material on the home machine, outside Git.
.collector/
collector-data/
work/collector/local/
.env
.env.*
!.env.example
*.cookies
*.session

# Future financial outputs are private. Existing tracked files need an explicit
# migration; these patterns do not remove files from Git or its history.
outputs/**/*.xlsx
collector/node_modules/
collector/local/
collector/private/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.enc
*.enc.*.partial
