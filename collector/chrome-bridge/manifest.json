{
  "manifest_version": 3,
  "name": "Budget Collector Bridge",
  "version": "0.4.15",
  "description": "Local, read-only Wells, Chase, Citi and PayPal financing connection.",
  "permissions": ["tabs", "alarms", "debugger", "webNavigation"],
  "host_permissions": [
    "https://*.wellsfargo.com/*",
    "https://*.chase.com/*",
    "https://*.citi.com/*",
    "https://www.paypal.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.paypal.com/*"],
      "js": ["paypal-page-state.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.citi.com/*"],
      "js": ["citi-page-state.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.wellsfargo.com/*"],
      "js": ["wells-page-state.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.chase.com/*"],
      "js": ["chase-page-state.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
